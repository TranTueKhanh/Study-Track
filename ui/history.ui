   <string notr="true">
QMainWindow {
    background-color: #FFF7F5;
}

QWidget {
    font-family: &quot;Segoe UI&quot;;
    color: #1F2933;
    font-size: 13px;
}

QFrame#Sidebar {
    background-color: #FFFFFF;
    border-right: 1px solid #E5E7EB;
}

QFrame#TopBar {
    background-color: transparent;
    border: none;
}

QFrame#FilterCard,
QFrame#HistoryTableCard,
QFrame#PreviewCard,
QFrame#InsightCard,
QFrame#ActionCard,
QFrame#SidebarStatusCard {
    background-color: #FFFFFF;
    border: 1px solid #EEF2F7;
    border-radius: 22px;
}

QFrame#FilterCard:hover,
QFrame#HistoryTableCard:hover,
QFrame#PreviewCard:hover,
QFrame#InsightCard:hover,
QFrame#SidebarStatusCard:hover,
QFrame#ActionCard:hover {
    border: 1px solid #FFD0D0;
}

QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 14px;
    padding: 8px 12px;
    color: #1F2933;
}

QPushButton:hover {
    background-color: #FFF1F1;
    border: 1px solid #FF6B6B;
}

QPushButton:pressed {
    background-color: #FFE4E4;
}

QPushButton#BtnHistory {
    background-color: #FFF1F1;
    border: 1px solid #FFBDBD;
    color: #C94A4A;
    font-weight: 700;
}

QPushButton#BtnDashboard,
QPushButton#BtnSession,
QPushButton#BtnHistory,
QPushButton#BtnEditRecord,
QPushButton#BtnStats,
QPushButton#BtnProfile {
    text-align: left;
    padding-left: 18px;
    min-height: 46px;
    font-size: 14px;
    font-weight: 500;
    border-radius: 18px;
}

QPushButton#btnAddNewRecord {
    background-color: #FF6B6B;
    color: #FFFFFF;
    border: none;
    font-size: 14px;
    font-weight: 800;
    border-radius: 16px;
}

QPushButton#btnAddNewRecord:hover {
    background-color: #E85A5A;
}

QPushButton#btnClearFilter {
    background-color: #FFFFFF;
    color: #EF4444;
    border: 1px solid #FECACA;
    font-weight: 600;
    border-radius: 16px;
}

QPushButton#btnEditSelected {
    background-color: #F97316;
    color: #FFFFFF;
    border: none;
    font-weight: 800;
    border-radius: 16px;
}

QPushButton#btnEditSelected:hover {
    background-color: #EA580C;
}

QPushButton#btnDeleteSelected {
    background-color: #FEF2F2;
    color: #EF4444;
    border: 1px solid #FECACA;
    font-weight: 800;
    border-radius: 16px;
}

QPushButton#btnDeleteSelected:hover,
QPushButton#btnClearFilter:hover {
    background-color: #FEE2E2;
    border: 1px solid #EF4444;
}

QPushButton#BtnBell,
QPushButton#BtnAvatar {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 18px;
    font-size: 16px;
}

QPushButton#BtnBell:hover,
QPushButton#BtnAvatar:hover {
    background-color: #FFF1F1;
}

QLabel#lblSidebarStatusTitle,
QLabel#lblSidebarStatusValue,
QLabel#lblSidebarStatusSub {
    background: transparent;
    border: none;
}

QLabel#lblSidebarAppTitle {
    font-size: 18px;
    font-weight: 800;
}

QLabel#lblSidebarSubTitle {
    color: #94A3B8;
    font-size: 11px;
}

QLabel#lblSectionMenu,
QLabel#lblSectionStatus {
    color: #9CA3AF;
    font-size: 11px;
    font-weight: 700;
}

QLabel#lblGreeting {
    font-size: 24px;
    font-weight: 800;
}

QLabel#lblDateToday {
    color: #9CA3AF;
    font-size: 12px;
}

QLabel#lblFilterTitle,
QLabel#lblHistoryTitle,
QLabel#lblPreviewTitle,
QLabel#lblInsightTitle,
QLabel#lblActionTitle {
    color: #6B7280;
    font-size: 12px;
    font-weight: 700;
}

QLabel#lblSearch,
QLabel#lblFilterSubject,
QLabel#lblSortBy,
QLabel#lblDateFrom,
QLabel#lblDateTo {
    color: #374151;
    font-size: 12px;
    font-weight: 700;
}

QLabel#lblPreviewSubject {
    font-size: 24px;
    font-weight: 800;
    color: #1F2933;
}

QLabel#lblPreviewMeta,
QLabel#lblPreviewContent,
QLabel#lblInsightBody,
QLabel#lblActionHint,
QLabel#lblRecordCount {
    color: #6B7280;
    font-size: 12px;
}

QLabel#lblPreviewBadge {
    background-color: #ECFDF5;
    color: #059669;
    border: 1px solid #CFF8E3;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 700;
    padding-left: 8px;
}

QLineEdit,
QComboBox,
QDateEdit {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 14px;
    padding: 8px 10px;
    color: #1F2933;
}

QLineEdit:focus,
QComboBox:focus,
QDateEdit:focus {
    border: 1px solid #FF6B6B;
    background-color: #FFFBFB;
}

QComboBox::drop-down,
QDateEdit::drop-down {
    border: none;
    width: 24px;
}

QTableWidget {
    background-color: transparent;
    border: none;
    gridline-color: #F3F4F6;
    selection-background-color: #FFF1F1;
    selection-color: #1F2933;
    outline: 0;
}

QHeaderView::section {
    background-color: #F9FAFB;
    color: #6B7280;
    border: none;
    border-bottom: 1px solid #E5E7EB;
    padding: 8px;
    font-weight: 800;
    font-size: 12px;
}

QTableWidget::item {
    padding: 8px;
    border-bottom: 1px solid #F3F4F6;
}

QTableWidget::item:hover {
    background-color: #FFF7F7;
}

QScrollBar:vertical {
    background: #F9FAFB;
    width: 8px;
    margin: 0px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #FFD0D0;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #FFBDBD;
}
