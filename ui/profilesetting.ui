  <property name="styleSheet">
   <string notr="true">
QMainWindow {
    background-color: #FFF7F5;
}

QWidget {
    font-family: &quot;Segoe UI&quot;;
    color: #1F2933;
    font-size: 13px;
}

QFrame#Sidebar {
    background-color: #FFFFFF;
    border-right: 1px solid #E5E7EB;
}

QFrame#TopBar {
    background-color: transparent;
    border: none;
}

QFrame#ProfileCard,
QFrame#GoalSettingsCard,
QFrame#SubjectGoalCard,
QFrame#PreferencesCard,
QFrame#DataActionCard,
QFrame#AccountActionCard,
QFrame#SidebarStatusCard {
    background-color: #FFFFFF;
    border: 1px solid #EEF2F7;
    border-radius: 22px;
}

QFrame#ProfileCard:hover,
QFrame#GoalSettingsCard:hover,
QFrame#SubjectGoalCard:hover,
QFrame#PreferencesCard:hover,
QFrame#DataActionCard:hover,
QFrame#SidebarStatusCard:hover,
QFrame#AccountActionCard:hover {
    border: 1px solid #FFD0D0;
}

QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 14px;
    padding: 8px 12px;
    color: #1F2933;
}

QPushButton:hover {
    background-color: #FFF1F1;
    border: 1px solid #FF6B6B;
}

QPushButton:pressed {
    background-color: #FFE4E4;
}

QPushButton#BtnProfile {
    background-color: #FFF1F1;
    border: 1px solid #FFBDBD;
    color: #C94A4A;
    font-weight: 700;
}

QPushButton#BtnDashboard,
QPushButton#BtnSession,
QPushButton#BtnHistory,
QPushButton#BtnEditRecord,
QPushButton#BtnStats,
QPushButton#BtnProfile {
    text-align: left;
    padding-left: 18px;
    min-height: 46px;
    font-size: 14px;
    font-weight: 500;
    border-radius: 18px;
}

QPushButton#btnSaveProfile,
QPushButton#btnSaveGoals,
QPushButton#btnSavePreferences {
    background-color: #22C55E;
    color: #FFFFFF;
    border: none;
    font-weight: 800;
    border-radius: 16px;
}

QPushButton#btnSaveProfile:hover,
QPushButton#btnSaveGoals:hover,
QPushButton#btnSavePreferences:hover {
    background-color: #16A34A;
}

QPushButton#btnExportData,
QPushButton#btnImportData {
    background-color: #FFFFFF;
    color: #F97316;
    border: 1px solid #FED7AA;
    font-weight: 800;
    border-radius: 16px;
}

QPushButton#btnExportData:hover,
QPushButton#btnImportData:hover {
    background-color: #FFF7ED;
    border: 1px solid #F97316;
}

QPushButton#btnLogout {
    background-color: #FEF2F2;
    color: #EF4444;
    border: 1px solid #FECACA;
    font-weight: 800;
    border-radius: 16px;
}

QPushButton#btnLogout:hover {
    background-color: #FEE2E2;
    border: 1px solid #EF4444;
}

QPushButton#btnResetData {
    background-color: #FFFFFF;
    color: #EF4444;
    border: 1px solid #FECACA;
    font-weight: 700;
    border-radius: 16px;
}

QPushButton#btnResetData:hover {
    background-color: #EF4444;
    color: #FFFFFF;
    border: 1px solid #EF4444;
}

QPushButton#BtnBell,
QPushButton#BtnAvatar {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 18px;
    font-size: 16px;
}

QPushButton#BtnBell:hover,
QPushButton#BtnAvatar:hover {
    background-color: #FFF1F1;
}

QLabel#lblSidebarStatusTitle,
QLabel#lblSidebarStatusValue,
QLabel#lblSidebarStatusSub {
    background: transparent;
    border: none;
}

QLabel#lblSidebarAppTitle {
    font-size: 18px;
    font-weight: 800;
}

QLabel#lblSidebarSubTitle {
    color: #94A3B8;
    font-size: 11px;
}

QLabel#lblSectionMenu,
QLabel#lblSectionStatus {
    color: #9CA3AF;
    font-size: 11px;
    font-weight: 700;
}

QLabel#lblGreeting {
    font-size: 24px;
    font-weight: 800;
}

QLabel#lblDateToday {
    color: #9CA3AF;
    font-size: 12px;
}

QLabel#lblProfileTitle,
QLabel#lblGoalSettingsTitle,
QLabel#lblSubjectGoalTitle,
QLabel#lblPreferencesTitle,
QLabel#lblDataActionTitle,
QLabel#lblAccountActionTitle {
    color: #6B7280;
    font-size: 12px;
    font-weight: 700;
}

QLabel#lblProfileName {
    font-size: 26px;
    font-weight: 800;
    color: #1F2933;
}

QLabel#lblProfileMeta,
QLabel#lblTotalHoursSub,
QLabel#lblBestStreakSub,
QLabel#lblDailyGoalHint,
QLabel#lblSubjectGoalHint,
QLabel#lblPreferenceHint,
QLabel#lblDataActionHint,
QLabel#lblAccountHint {
    color: #6B7280;
    font-size: 12px;
}

QLabel#lblTotalHoursValue,
QLabel#lblBestStreakValue {
    font-size: 24px;
    font-weight: 800;
    color: #1F2933;
}

QLabel#lblInputDisplayName,
QLabel#lblInputDailyGoal,
QLabel#lblInputDefaultSession,
QLabel#lblMathGoal,
QLabel#lblEnglishGoal,
QLabel#lblPhysicsGoal,
QLabel#lblThemeMode,
QLabel#lblNotificationMode {
    color: #374151;
    font-size: 12px;
    font-weight: 700;
}

QLineEdit,
QComboBox,
QSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 14px;
    padding: 8px 10px;
    color: #1F2933;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus {
    border: 1px solid #FF6B6B;
    background-color: #FFFBFB;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QCheckBox {
    color: #374151;
    font-size: 12px;
    font-weight: 600;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
}

QProgressBar {
    border: none;
    background-color: #F3F4F6;
    border-radius: 10px;
    text-align: center;
    color: #1F2933;
    height: 12px;
}

QProgressBar::chunk {
    background-color: #FF6B6B;
    border-radius: 10px;
}

QLabel#lblProfileBadge {
    background-color: #ECFDF5;
    color: #059669;
    border: 1px solid #CFF8E3;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 700;
    padding-left: 8px;
}

QLabel#lblGoalBadge {
    background-color: #FFF7ED;
    color: #EA580C;
    border: 1px solid #FED7AA;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 700;
    padding-left: 8px;
}

QLabel#lblDangerBadge {
    background-color: #FEF2F2;
    color: #EF4444;
    border: 1px solid #FECACA;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 700;
    padding-left: 8px;
}
