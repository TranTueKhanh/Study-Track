   <string notr="true">
QMainWindow {
    background-color: #FFF7F5;
}

QWidget {
    font-family: &quot;Segoe UI&quot;;
    color: #1F2933;
    font-size: 13px;
}

QFrame#Sidebar {
    background-color: #FFFFFF;
    border-right: 1px solid #E5E7EB;
}

QFrame#TopBar {
    background-color: transparent;
    border: none;
}

QFrame#CrudCard,
QFrame#SummaryCard,
QFrame#HelperCard,
QFrame#SidebarStatusCard,
QFrame#ActionCard {
    background-color: #FFFFFF;
    border: 1px solid #EEF2F7;
    border-radius: 22px;
}

QFrame#CrudCard:hover,
QFrame#SummaryCard:hover,
QFrame#SidebarStatusCard:hover,
QFrame#HelperCard:hover,
QFrame#ActionCard:hover {
    border: 1px solid #FFD0D0;
}

QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 14px;
    padding: 8px 12px;
    color: #1F2933;
}

QPushButton:hover {
    background-color: #FFF1F1;
    border: 1px solid #FF6B6B;
}

QPushButton:pressed {
    background-color: #FFE4E4;
}

QPushButton#BtnEditRecord {
    background-color: #FFF1F1;
    border: 1px solid #FFBDBD;
    color: #C94A4A;
    font-weight: 700;
}

QPushButton#BtnDashboard,
QPushButton#BtnSession,
QPushButton#BtnHistory,
QPushButton#BtnStats,
QPushButton#BtnProfile,
QPushButton#BtnEditRecord {
    text-align: left;
    padding-left: 18px;
    min-height: 46px;
    font-size: 14px;
    font-weight: 500;
    border-radius: 18px;
}

QPushButton#btnSaveRecord {
    background-color: #22C55E;
    color: #FFFFFF;
    border: none;
    font-weight: 700;
    border-radius: 16px;
}

QPushButton#btnSaveRecord:hover {
    background-color: #16A34A;
}

QPushButton#btnSaveAndAddNew {
    background-color: #F97316;
    color: #FFFFFF;
    border: none;
    font-weight: 700;
    border-radius: 16px;
}

QPushButton#btnSaveAndAddNew:hover {
    background-color: #EA580C;
}

QPushButton#btnCancelRecord {
    background-color: #FFFFFF;
    color: #6B7280;
    border: 1px solid #D1D5DB;
    font-weight: 600;
    border-radius: 16px;
}

QPushButton#btnDeleteRecord {
    background-color: #FEF2F2;
    color: #EF4444;
    border: 1px solid #FECACA;
    font-weight: 700;
    border-radius: 16px;
}

QPushButton#btnDeleteRecord:hover {
    background-color: #FEE2E2;
    border: 1px solid #EF4444;
}

QPushButton#BtnBell,
QPushButton#BtnAvatar,
QPushButton#btnBackHistory {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 18px;
    font-size: 16px;
}

QPushButton#BtnBell:hover,
QPushButton#BtnAvatar:hover {
    background-color: #FFF1F1;
}

QLabel#lblSidebarStatusTitle,
QLabel#lblSidebarStatusValue,
QLabel#lblSidebarStatusSub {
    background: transparent;
    border: none;
}

QLabel#lblSidebarAppTitle {
    font-size: 18px;
    font-weight: 800;
}

QLabel#lblSidebarSubTitle {
    color: #94A3B8;
    font-size: 11px;
}

QLabel#lblSectionMenu,
QLabel#lblSectionStatus {
    color: #9CA3AF;
    font-size: 11px;
    font-weight: 700;
}

QLabel#lblGreeting {
    font-size: 24px;
    font-weight: 800;
}

QLabel#lblDateToday {
    color: #9CA3AF;
    font-size: 12px;
}

QLabel#lblRecordFormTitle {
    font-size: 26px;
    font-weight: 800;
}

QLabel#lblRecordFormSubtitle,
QLabel#lblFormHint,
QLabel#lblSummaryText,
QLabel#lblHelperBody {
    color: #6B7280;
    font-size: 12px;
}

QLabel#lblSectionMain,
QLabel#lblSectionTime,
QLabel#lblSectionContent,
QLabel#lblSectionQuality,
QLabel#lblSectionNote,
QLabel#lblSummaryTitle,
QLabel#lblHelperTitle {
    color: #6B7280;
    font-size: 12px;
    font-weight: 700;
}

QLabel#lblInputSubject,
QLabel#lblInputDate,
QLabel#lblInputTag,
QLabel#lblInputDuration,
QLabel#lblInputStartTime,
QLabel#lblInputEndTime,
QLabel#lblInputContent,
QLabel#lblInputEffectiveness,
QLabel#lblInputMood,
QLabel#lblInputNote {
    color: #374151;
    font-size: 12px;
    font-weight: 700;
}

QLabel#lblFormError {
    color: #EF4444;
    font-size: 12px;
    font-weight: 600;
}

QLabel#lblSummaryValue {
    font-size: 24px;
    font-weight: 800;
    color: #1F2933;
}

QLineEdit,
QTextEdit,
QComboBox,
QDateEdit,
QTimeEdit,
QSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 14px;
    padding: 8px 10px;
    color: #1F2933;
}

QLineEdit:focus,
QTextEdit:focus,
QComboBox:focus,
QDateEdit:focus,
QTimeEdit:focus,
QSpinBox:focus {
    border: 1px solid #FF6B6B;
    background-color: #FFFBFB;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QDateEdit::drop-down,
QTimeEdit::drop-down {
    border: none;
    width: 24px;
}

QSlider::groove:horizontal {
    border: none;
    height: 8px;
    background: #F3F4F6;
    border-radius: 4px;
}

QSlider::handle:horizontal {
    background: #FF6B6B;
    border: 2px solid #FFFFFF;
    width: 18px;
    margin: -6px 0;
    border-radius: 9px;
}

QSlider::sub-page:horizontal {
    background: #FF6B6B;
    border-radius: 4px;
}
