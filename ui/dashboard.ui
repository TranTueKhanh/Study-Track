  <property name="styleSheet">
   <string notr="true">
QMainWindow {
    background-color: #FFF7F5;
}

QWidget {
    font-family: &quot;Segoe UI&quot;;
    color: #1F2933;
    font-size: 13px;
}

QFrame#Sidebar {
    background-color: #FFFFFF;
    border-right: 1px solid #E5E7EB;
}

QFrame#TopBar {
    background-color: transparent;
    border: none;
}

QFrame#HeroCard,
QFrame#CardTodayTime,
QFrame#CardWeekTime,
QFrame#CardStreak,
QFrame#CardTopSubject,
QFrame#GoalCard,
QFrame#RecentCard,
QFrame#InsightCard,
QFrame#MiniTipCard,
QFrame#SidebarStatusCard {
    background-color: #FFFFFF;
    border: 1px solid #EEF2F7;
    border-radius: 22px;
}

QFrame#HeroCard:hover,
QFrame#CardTodayTime:hover,
QFrame#CardWeekTime:hover,
QFrame#CardStreak:hover,
QFrame#CardTopSubject:hover,
QFrame#GoalCard:hover,
QFrame#RecentCard:hover,
QFrame#InsightCard:hover,
QFrame#SidebarStatusCard:hover,
QFrame#MiniTipCard:hover {
    border: 1px solid #FFD0D0;
}

QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 14px;
    padding: 8px 12px;
    color: #1F2933;
}

QPushButton:hover {
    background-color: #FFF1F1;
    border: 1px solid #FF6B6B;
}

QPushButton:pressed {
    background-color: #FFE4E4;
}

QPushButton#BtnDashboard {
    background-color: #FFF1F1;
    border: 1px solid #FFBDBD;
    color: #C94A4A;
    font-weight: 700;
}

QPushButton#BtnStartSession {
    background-color: #FF6B6B;
    color: #FFFFFF;
    border: none;
    font-size: 14px;
    font-weight: 700;
    border-radius: 16px;
}

QPushButton#BtnStartSession:hover {
    background-color: #E85A5A;
}

QPushButton#BtnQuickAddRecord {
    background-color: #FFFFFF;
    color: #F97316;
    border: 1px solid #FED7AA;
    font-weight: 700;
    border-radius: 16px;
}

QPushButton#BtnQuickAddRecord:hover {
    background-color: #FFF7ED;
    border: 1px solid #F97316;
}

QPushButton#BtnBell,
QPushButton#BtnAvatar {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 18px;
    font-size: 16px;
}

QPushButton#BtnBell:hover,
QPushButton#BtnAvatar:hover {
    background-color: #FFF1F1;
}

QPushButton#BtnDashboard,
QPushButton#BtnSession,
QPushButton#BtnHistory,
QPushButton#BtnEditRecord,
QPushButton#BtnStats,
QPushButton#BtnProfile {
    text-align: left;
    padding-left: 18px;
    min-height: 46px;
    font-size: 14px;
    font-weight: 500;
    border-radius: 18px;
}

QLabel#lblSidebarStatusTitle,
QLabel#lblSidebarStatusValue,
QLabel#lblSidebarStatusSub {
    background: transparent;
    border: none;
}

QLabel#lblSidebarAppTitle {
    font-size: 18px;
    font-weight: 800;
}

QLabel#lblSidebarSubTitle {
    color: #94A3B8;
    font-size: 11px;
}

QLabel#lblSectionMenu,
QLabel#lblSectionStatus {
    color: #9CA3AF;
    font-size: 11px;
    font-weight: 700;
}

QLabel#lblGreeting {
    font-size: 24px;
    font-weight: 800;
}

QLabel#lblDateToday {
    color: #9CA3AF;
    font-size: 12px;
}

QLabel#lblHeroEyebrow {
    color: #F97316;
    font-size: 12px;
    font-weight: 700;
}

QLabel#lblHeroTitle {
    font-size: 28px;
    font-weight: 800;
}

QLabel#lblHeroSubtitle,
QLabel#lblTodaySub,
QLabel#lblWeekSub,
QLabel#lblStreakSub,
QLabel#lblTopSubjectSub,
QLabel#lblGoalRemaining,
QLabel#lblInsightBody,
QLabel#lblMiniTipBody {
    color: #6B7280;
    font-size: 12px;
}

QLabel#lblCardTitleToday,
QLabel#lblCardTitleWeek,
QLabel#lblCardTitleStreak,
QLabel#lblCardTitleTopSubject,
QLabel#lblGoalTitle,
QLabel#lblRecentTitle,
QLabel#lblInsightTitle,
QLabel#lblMiniTipTitle {
    color: #6B7280;
    font-size: 12px;
    font-weight: 700;
}

QLabel#lblTodayValue,
QLabel#lblWeekValue,
QLabel#lblStreakValue,
QLabel#lblTopSubjectValue,
QLabel#lblGoalProgressText {
    font-size: 24px;
    font-weight: 800;
}

QProgressBar {
    border: none;
    background-color: #F3F4F6;
    border-radius: 10px;
    text-align: center;
    color: #1F2933;
    height: 12px;
}

QProgressBar::chunk {
    background-color: #FF6B6B;
    border-radius: 10px;
}

QListWidget {
    background-color: transparent;
    border: none;
    outline: 0;
}

QListWidget::item {
    background-color: #FFF7F7;
    border: 1px solid #FDE2E2;
    border-radius: 12px;
    padding: 10px;
    margin-bottom: 8px;
}

QListWidget::item:hover {
    background-color: #FFF1F1;
    border: 1px solid #FFCACA;
}
   </string>
