   <string notr="true">
QMainWindow {
    background-color: #FFF7F5;
}

QWidget {
    font-family: &quot;Segoe UI&quot;;
    color: #1F2933;
    font-size: 13px;
}

QFrame#Sidebar {
    background-color: #FFFFFF;
    border-right: 1px solid #E5E7EB;
}

QFrame#TopBar {
    background-color: transparent;
    border: none;
}

QFrame#FilterCard,
QFrame#KpiTotalCard,
QFrame#KpiAvgCard,
QFrame#KpiTopSubjectCard,
QFrame#KpiGoalCard,
QFrame#PieChartCard,
QFrame#BarChartCard,
QFrame#GoalTrackingCard,
QFrame#InsightCard,
QFrame#SidebarStatusCard {
    background-color: #FFFFFF;
    border: 1px solid #EEF2F7;
    border-radius: 22px;
}

QFrame#FilterCard:hover,
QFrame#KpiTotalCard:hover,
QFrame#KpiAvgCard:hover,
QFrame#KpiTopSubjectCard:hover,
QFrame#KpiGoalCard:hover,
QFrame#PieChartCard:hover,
QFrame#BarChartCard:hover,
QFrame#SidebarStatusCard:hover,
QFrame#GoalTrackingCard:hover,
QFrame#InsightCard:hover {
    border: 1px solid #FFD0D0;
}

QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 14px;
    padding: 8px 12px;
    color: #1F2933;
}

QPushButton:hover {
    background-color: #FFF1F1;
    border: 1px solid #FF6B6B;
}

QPushButton:pressed {
    background-color: #FFE4E4;
}

QPushButton#BtnStats {
    background-color: #FFF1F1;
    border: 1px solid #FFBDBD;
    color: #C94A4A;
    font-weight: 700;
}

QPushButton#BtnDashboard,
QPushButton#BtnSession,
QPushButton#BtnHistory,
QPushButton#BtnEditRecord,
QPushButton#BtnStats,
QPushButton#BtnProfile {
    text-align: left;
    padding-left: 18px;
    min-height: 46px;
    font-size: 14px;
    font-weight: 500;
    border-radius: 18px;
}

QPushButton#btnRefreshStats {
    background-color: #FF6B6B;
    color: #FFFFFF;
    border: none;
    font-size: 14px;
    font-weight: 800;
    border-radius: 16px;
}

QPushButton#btnRefreshStats:hover {
    background-color: #E85A5A;
}

QPushButton#btnExportStats {
    background-color: #FFFFFF;
    color: #F97316;
    border: 1px solid #FED7AA;
    font-weight: 800;
    border-radius: 16px;
}

QPushButton#btnExportStats:hover {
    background-color: #FFF7ED;
    border: 1px solid #F97316;
}

QPushButton#BtnBell,
QPushButton#BtnAvatar {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 18px;
    font-size: 16px;
}

QPushButton#BtnBell:hover,
QPushButton#BtnAvatar:hover {
    background-color: #FFF1F1;
}

QLabel#lblSidebarStatusTitle,
QLabel#lblSidebarStatusValue,
QLabel#lblSidebarStatusSub {
    background: transparent;
    border: none;
}

QLabel#lblSidebarAppTitle {
    font-size: 18px;
    font-weight: 800;
}

QLabel#lblSidebarSubTitle {
    color: #94A3B8;
    font-size: 11px;
}

QLabel#lblSectionMenu,
QLabel#lblSectionStatus {
    color: #9CA3AF;
    font-size: 11px;
    font-weight: 700;
}

QLabel#lblGreeting {
    font-size: 24px;
    font-weight: 800;
}

QLabel#lblDateToday {
    color: #9CA3AF;
    font-size: 12px;
}

QLabel#lblFilterTitle,
QLabel#lblPieTitle,
QLabel#lblBarTitle,
QLabel#lblGoalTrackingTitle,
QLabel#lblInsightTitle {
    color: #6B7280;
    font-size: 12px;
    font-weight: 700;
}

QLabel#lblRange,
QLabel#lblSubjectFilter {
    color: #374151;
    font-size: 12px;
    font-weight: 700;
}

QLabel#lblKpiTotalTitle,
QLabel#lblKpiAvgTitle,
QLabel#lblKpiTopSubjectTitle,
QLabel#lblKpiGoalTitle {
    color: #6B7280;
    font-size: 12px;
    font-weight: 700;
}

QLabel#lblKpiTotalValue,
QLabel#lblKpiAvgValue,
QLabel#lblKpiTopSubjectValue,
QLabel#lblKpiGoalValue {
    font-size: 24px;
    font-weight: 800;
    color: #1F2933;
}

QLabel#lblKpiTotalSub,
QLabel#lblKpiAvgSub,
QLabel#lblKpiTopSubjectSub,
QLabel#lblKpiGoalSub,
QLabel#lblPieHint,
QLabel#lblBarHint,
QLabel#lblInsightBody,
QLabel#lblMathGoalText,
QLabel#lblEnglishGoalText,
QLabel#lblPhysicsGoalText {
    color: #6B7280;
    font-size: 12px;
}

QLabel#lblBadgeGood {
    background-color: #ECFDF5;
    color: #059669;
    border: 1px solid #CFF8E3;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 700;
    padding-left: 8px;
}

QLabel#lblBadgeWarning {
    background-color: #FFF7ED;
    color: #EA580C;
    border: 1px solid #FED7AA;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 700;
    padding-left: 8px;
}

QLabel#lblBadgeLow {
    background-color: #FEF2F2;
    color: #EF4444;
    border: 1px solid #FECACA;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 700;
    padding-left: 8px;
}

QLineEdit,
QComboBox,
QDateEdit {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 14px;
    padding: 8px 10px;
    color: #1F2933;
}

QComboBox:focus,
QDateEdit:focus {
    border: 1px solid #FF6B6B;
    background-color: #FFFBFB;
}

QComboBox::drop-down,
QDateEdit::drop-down {
    border: none;
    width: 24px;
}

QProgressBar {
    border: none;
    background-color: #F3F4F6;
    border-radius: 10px;
    text-align: center;
    color: #1F2933;
    height: 12px;
}

QProgressBar::chunk {
    background-color: #FF6B6B;
    border-radius: 10px;
}

QFrame#PiePlaceholder,
QFrame#BarPlaceholder {
    background-color: #FFF7F7;
    border: 1px dashed #FFD0D0;
    border-radius: 18px;
}

QLabel#lblPiePlaceholderText,
QLabel#lblBarPlaceholderText {
    color: #C94A4A;
    font-size: 13px;
    font-weight: 700;
}

QLabel#lblLegendMath {
    background-color: #FFF1F1;
    color: #C94A4A;
    border-radius: 10px;
    padding-left: 8px;
    font-size: 11px;
    font-weight: 700;
}

QLabel#lblLegendEnglish {
    background-color: #FFF7ED;
    color: #EA580C;
    border-radius: 10px;
    padding-left: 8px;
    font-size: 11px;
    font-weight: 700;
}

QLabel#lblLegendPhysics {
    background-color: #ECFDF5;
    color: #059669;
    border-radius: 10px;
    padding-left: 8px;
    font-size: 11px;
    font-weight: 700;
}

   </string>
