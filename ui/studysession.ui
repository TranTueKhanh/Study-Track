QMainWindow {
    background-color: #FFF7F5;
}

QWidget {
    font-family: &quot;Segoe UI&quot;;
    color: #1F2933;
    font-size: 13px;
}

QFrame#Sidebar {
    background-color: #FFFFFF;
    border-right: 1px solid #E5E7EB;
}

QFrame#TopBar {
    background-color: transparent;
    border: none;
}

QFrame#SessionCard,
QFrame#SetupCard,
QFrame#ControlCard,
QFrame#SessionStatsCard,
QFrame#SmartHintCard,
QFrame#EndFlowCard,
QFrame#SidebarStatusCard {
    background-color: #FFFFFF;
    border: 1px solid #EEF2F7;
    border-radius: 22px;
}

QFrame#SessionCard:hover,
QFrame#SetupCard:hover,
QFrame#ControlCard:hover,
QFrame#SessionStatsCard:hover,
QFrame#SidebarStatusCard:hover,
QFrame#SmartHintCard:hover,
QFrame#EndFlowCard:hover {
    border: 1px solid #FFD0D0;
}

QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 14px;
    padding: 8px 12px;
    color: #1F2933;
}

QPushButton:hover {
    background-color: #FFF1F1;
    border: 1px solid #FF6B6B;
}

QPushButton:pressed {
    background-color: #FFE4E4;
}

QPushButton#BtnSession {
    background-color: #FFF1F1;
    border: 1px solid #FFBDBD;
    color: #C94A4A;
    font-weight: 700;
}

QPushButton#BtnDashboard,
QPushButton#BtnSession,
QPushButton#BtnHistory,
QPushButton#BtnEditRecord,
QPushButton#BtnStats,
QPushButton#BtnProfile {
    text-align: left;
    padding-left: 18px;
    min-height: 46px;
    font-size: 14px;
    font-weight: 500;
    border-radius: 18px;
}

QPushButton#btnStartTimer {
    background-color: #FF6B6B;
    color: #FFFFFF;
    border: none;
    font-size: 14px;
    font-weight: 800;
    border-radius: 18px;
}

QPushButton#btnStartTimer:hover {
    background-color: #E85A5A;
}

QPushButton#btnPauseTimer {
    background-color: #F97316;
    color: #FFFFFF;
    border: none;
    font-size: 14px;
    font-weight: 800;
    border-radius: 18px;
}

QPushButton#btnPauseTimer:hover {
    background-color: #EA580C;
}

QPushButton#btnResumeTimer {
    background-color: #22C55E;
    color: #FFFFFF;
    border: none;
    font-size: 14px;
    font-weight: 800;
    border-radius: 18px;
}

QPushButton#btnResumeTimer:hover {
    background-color: #16A34A;
}

QPushButton#btnEndSession {
    background-color: #FEF2F2;
    color: #EF4444;
    border: 1px solid #FECACA;
    font-size: 14px;
    font-weight: 800;
    border-radius: 18px;
}

QPushButton#btnEndSession:hover {
    background-color: #FEE2E2;
    border: 1px solid #EF4444;
}

QPushButton#btnBackDashboard:hover{
    background-color: #FFF1F1;
    border: 1px solid #FF6B6B;
}

QPushButton#BtnBell,
QPushButton#BtnAvatar,
QPushButton#btnBackDashboard {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 18px;
    font-size: 16px;
}

QPushButton#BtnBell:hover,
QPushButton#BtnAvatar:hover {
    background-color: #FFF1F1;
}

QLabel#lblSidebarStatusTitle,
QLabel#lblSidebarStatusValue,
QLabel#lblSidebarStatusSub {
    background: transparent;
    border: none;
}

QLabel#lblSidebarAppTitle {
    font-size: 18px;
    font-weight: 800;
}

QLabel#lblSidebarSubTitle {
    color: #94A3B8;
    font-size: 11px;
}

QLabel#lblSectionMenu,
QLabel#lblSectionStatus {
    color: #9CA3AF;
    font-size: 11px;
    font-weight: 700;
}

QLabel#lblGreeting {
    font-size: 24px;
    font-weight: 800;
}

QLabel#lblDateToday {
    color: #9CA3AF;
    font-size: 12px;
}

QLabel#lblSessionTitle {
    font-size: 26px;
    font-weight: 800;
}

QLabel#lblSessionSubtitle,
QLabel#lblSetupHint,
QLabel#lblControlHint,
QLabel#lblSmartHintBody,
QLabel#lblEndFlowBody,
QLabel#lblTimerSub,
QLabel#lblFocusTip {
    color: #6B7280;
    font-size: 12px;
}

QLabel#lblSetupTitle,
QLabel#lblControlTitle,
QLabel#lblStatsTitle,
QLabel#lblSmartHintTitle,
QLabel#lblEndFlowTitle {
    color: #6B7280;
    font-size: 12px;
    font-weight: 700;
}

QLabel#lblInputSubject,
QLabel#lblInputMode,
QLabel#lblInputTopic,
QLabel#lblInputTarget,
QLabel#lblElapsedTitle,
QLabel#lblPauseTitle,
QLabel#lblStatusTitle,
QLabel#lblStartTimeTitle {
    color: #374151;
    font-size: 12px;
    font-weight: 700;
}

QLabel#lblTimerDisplay {
    font-size: 54px;
    font-weight: 900;
    color: #1F2933;
}

QLabel#lblSessionStatus {
    background-color: #FFF7ED;
    color: #EA580C;
    border: 1px solid #FED7AA;
    border-radius: 12px;
    padding-left: 10px;
    font-size: 12px;
    font-weight: 700;
}

QLabel#lblElapsedValue,
QLabel#lblPauseCount,
QLabel#lblStartTimeValue {
    font-size: 22px;
    font-weight: 800;
    color: #1F2933;
}

QLineEdit,
QTextEdit,
QComboBox,
QSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 14px;
    padding: 8px 10px;
    color: #1F2933;
}

QLineEdit:focus,
QTextEdit:focus,
QComboBox:focus,
QSpinBox:focus {
    border: 1px solid #FF6B6B;
    background-color: #FFFBFB;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QProgressBar {
    border: none;
    background-color: #F3F4F6;
    border-radius: 10px;
    text-align: center;
    color: #1F2933;
    height: 12px;
}

QProgressBar::chunk {
    background-color: #FF6B6B;
    border-radius: 10px;
}

QLabel#lblBadgeFocus {
    background-color: #FFF1F1;
    color: #C94A4A;
    border: 1px solid #FFD7D7;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 700;
    padding-left: 8px;
}

QLabel#lblBadgeAutoFill {
    background-color: #ECFDF5;
    color: #059669;
    border: 1px solid #CFF8E3;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 700;
    padding-left: 8px;
}

QLabel#lblBadgeTimer {
    background-color: #FFF7ED;
    color: #EA580C;
    border: 1px solid #FED7AA;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 700;
    padding-left: 8px;
}
